# 隔离执行器镜像：非 root（65534:65534），依赖构建期装好，运行期可断网
# 构建：docker build -f infra/Dockerfile.runner -t changeproof-runner:latest .
ARG BASE_IMAGE=python:3.13-slim
FROM ${BASE_IMAGE}

# 允许在受限网络下指定镜像源；留空则使用 pip 默认源
ARG PIP_INDEX_URL=""

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/work \
    COVERAGE_FILE=/artifacts/.coverage \
    COVERAGE_CORE=pytrace \
    COVERAGE_RCFILE=/opt/runner/coveragerc

RUN python -m pip install ${PIP_INDEX_URL:+--index-url "${PIP_INDEX_URL}"} \
        "pytest>=8.0" "coverage>=7.4" "pytest-cov>=5.0"

COPY infra/runner/net_check.py /opt/runner/net_check.py
COPY infra/runner/coveragerc /opt/runner/coveragerc

# /work 以只读方式挂载快照；/artifacts 可写，用于日志与覆盖率回读
RUN mkdir -p /work /artifacts \
    && chmod 0555 /work \
    && chown 65534:65534 /artifacts \
    && chmod 0777 /artifacts

WORKDIR /work

USER 65534:65534

CMD ["python", "-m", "pytest", "--version"]