FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CHANGEPROOF_ARTIFACTS_ROOT=/app/var/artifacts \
    CHANGEPROOF_DB_URL=sqlite:////app/var/changeproof.db

WORKDIR /app

# 先装依赖再拷代码，便于复用构建缓存；git 用于仓库校验与快照导出
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY core ./core
COPY services ./services
RUN pip install --no-cache-dir .

COPY scripts ./scripts
COPY eval ./eval

RUN mkdir -p /app/var/artifacts \
    && useradd --create-home --uid 10001 changeproof \
    && chown -R changeproof:changeproof /app/var

USER changeproof

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "services.api.main:app", "--host", "0.0.0.0", "--port", "8000"]